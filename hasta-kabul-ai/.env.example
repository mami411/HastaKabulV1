# HastaKabul yapay zekâ servisleri — ortam değişkenleri (örnek).
# Kopyalayın: copy .env.example .env   (.env depoya girmez; gerçek sır buraya YAZILMAZ)
# Kodda sabit değer yoktur: model, ses, port, zaman aşımı, anahtar, adresler buradan okunur.

# ---------------------------------------------------------------- Sunucu
SES_HOST=127.0.0.1
SES_PORT=8002
# Virgülle ayrılmış; kiosk 5173, hekim paneli 5174, portal 5175
CORS_IZINLI_KAYNAKLAR=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# ---------------------------------------------------------------- HastaKabul API
HASTAKABUL_API_URL=http://localhost:3000
# Backend'in SERVICE_KEY değeriyle aynı olmalı. YALNIZ bu serviste durur; tarayıcıya asla gitmez.
SERVICE_KEY=
API_ZAMAN_ASIMI_SN=8

# ---------------------------------------------------------------- Konuşma akışı
OTURUM_OMRU_DK=20
AZAMI_OTURUM=500
# Poliklinik/gün söylenmediğinde bugünden itibaren kaç gün aranır
ARAMA_GUN_SAYISI=3
SUNULAN_SLOT_SAYISI=6
# İstenen günde yer yoksa en yakın seçenekler için taranacak gün sayısı
ALTERNATIF_GUN_SAYISI=7
# Backend slotları bugün dahil kaç gün için açıyor; daha ileri tarih istenirse dürüst şablon
RANDEVU_UFUK_GUN=8
# Geçmiş muayene / ilaç soruları: 0 = bilgi sesli okunmaz, yalnız ekrandaki kartta gösterilir
GECMIS_SESLI_OKUMA=1
# 1 = geçmiş sorgusu ek doğrulama ister; ek doğrulama ucu henüz yok, bu yüzden kapalı başarısız olur
GECMIS_IKINCI_FAKTOR=0
# medical-history?limit= (backend 1-5 kabul eder)
GECMIS_LIMIT=3
# Genel sağlık / ilaç bilgi sorusu ("aspirin ne işe yarar", "baş ağrısına ne iyi gelir"): 1 = yerel LLM kısa
# genel bilgi yazar (yalnız kimliği maskelenmiş soru gider; çıktı kodda denetlenir; "doktorunuza danışın"
# kapanışı koddan eklenir). 0 = eski davranış ("tıbbi yorum yapamıyorum"). Kişiye özel sorular (doz, bırakma,
# tahlil, teşhis) her iki durumda da sabit metinle doktora yönlendirilir.
SAGLIK_BILGI_LLM=1
SAGLIK_BILGI_ZAMAN_ASIMI_SN=10
# İsteğe bağlı: bilgi yolu için ayrı yerel model (boşsa SES_LLM_MODEL). Ayarlar SAGLIK_LLM_*, yoksa LLM_* okunur.
# Değerlendirmede gemma3:4b Türkçe tıbbi bilgide qwen3:4b'den belirgin doğruydu; ancak 6 GB GPU'da iki model
# birbirini bellekten atar (geçişte ~3-5 sn). Bkz. README "Genel sağlık bilgisi".
# SAGLIK_LLM_MODEL=gemma3:4b
# Şu andan en az kaç dakika sonraki slotlar sunulur
SLOT_MIN_ONCE_DK=5
AZAMI_METIN_UZUNLUGU=500
# Son istekten bu kadar saniye sonra gelen onay reddedilir ve geçmiş muayene kilitlenir (kimlik yeniden
# doğrulanır). Kişisel cihaz (mobil cep asistanı) için 300; ortak kullanılan cihazda kısaltın.
OTURUM_BOSTA_SN=300
# /orchestrate ve /tts JSON gövdesi üst sınırı (bayt); /stt sınırı STT_AZAMI_BAYT'tan türetilir
AZAMI_JSON_GOVDE_BAYT=16384

# ---------------------------------------------------------------- LLM (ortak katman: ortak/llm)
# Her ayar önce SES_LLM_*, yoksa LLM_* olarak okunur (sadeleştirme servisi SADE_LLM_* kullanır).
# Profil 1 — TAM YEREL (varsayılan, hasta verisi makineden çıkmaz): Ollama
LLM_SAGLAYICI=openai_uyumlu
LLM_TABAN_URL=http://localhost:11434/v1
SES_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_API_ANAHTARI=
LLM_ZAMAN_ASIMI_SN=20
LLM_SICAKLIK=0.1
LLM_AZAMI_TOKEN=256
LLM_YENIDEN_DENEME=1
# sema | nesne | yok  (response_format biçimi; Groq için "nesne" daha uyumlu)
LLM_JSON_MODU=sema
# İsteğe eklenecek JSON (ör. Ollama bağlam boyu): {"options":{"num_ctx":4096}}
LLM_EK_GOVDE=
# LLM'i tamamen kapatmak (yalnız kural tabanlı anlama): SES_LLM_ETKIN=0
SES_LLM_ETKIN=1
# Anlama çağrısının zaman aşımı; aşılırsa kural tabanlı yedeğe düşülür
ANLAMA_ZAMAN_ASIMI_SN=12

# Profil 2 — HİBRİT (bulut LLM, ücretsiz katman). DİKKAT: kullanıcı cümleleri yurt dışına gider;
# KVKK değerlendirmesi yapılmadan açmayın. TC zaten maskelenir ama serbest metinde ad vb. olabilir.
# LLM_TABAN_URL=https://api.groq.com/openai/v1
# SES_LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_ANAHTARI=<groq-anahtari>
# LLM_JSON_MODU=nesne
#   ya da Gemini:
# LLM_TABAN_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SES_LLM_MODEL=gemini-2.0-flash
# LLM_API_ANAHTARI=<gemini-anahtari>
#   ya da Anthropic (pip install anthropic gerekir):
# LLM_SAGLAYICI=anthropic
# SES_LLM_MODEL=<model-adi>
# LLM_API_ANAHTARI=<anthropic-anahtari>

# ---------------------------------------------------------------- STT (konuşmadan metne)
# yerel = faster-whisper (varsayılan) | bulut = OpenAI uyumlu /audio/transcriptions (ör. Groq)
STT_SAGLAYICI=yerel
STT_MODEL=large-v3-turbo
# auto (CUDA varsa GPU, yoksa CPU) | cuda | cpu
STT_CIHAZ=auto
# auto: GPU'da int8_float16, CPU'da int8
STT_HESAPLAMA=auto
STT_DIL=tr
STT_ISIN_GENISLIGI=1
# Model dosyalarının indirileceği klasör (boşsa ./modeller/whisper)
STT_MODEL_DIZINI=
# GPU için cuBLAS 12 DLL'leri: requirements-gpu.txt kurulduysa boş bırakın. Kurulamadıysa
# DLL'lerin bulunduğu klasör(ler), ';' ile ayrılmış. Ör. Ollama'nın kendi kopyası:
# STT_CUDA_DLL_DIZINLERI=C:\Users\<kullanici>\AppData\Local\Programs\Ollama\lib\ollama\cuda_v12
STT_CUDA_DLL_DIZINLERI=
STT_AZAMI_BAYT=5242880
STT_AZAMI_SANIYE=30
STT_ZAMAN_ASIMI_SN=30
STT_ONCEDEN_YUKLE=1
# Yalnız STT_SAGLAYICI=bulut için:
# STT_BULUT_URL=https://api.groq.com/openai/v1
# STT_BULUT_ANAHTAR=<anahtar>

# ---------------------------------------------------------------- TTS (metinden konuşmaya, Piper)
# .onnx ve yanındaki .onnx.json gerekir (boşsa ./modeller/piper/tr_TR-dfki-medium.onnx)
TTS_MODEL_YOLU=
TTS_KONUSMA_HIZI=1.0
TTS_AZAMI_KARAKTER=600
TTS_ZAMAN_ASIMI_SN=20
TTS_ONCEDEN_YUKLE=1
TTS_CUDA=0

# ---------------------------------------------------------------- Ortak
# Modellerin kök klasörü (boşsa ./modeller)
MODEL_DIZINI=
# Teşhis logu: 1 ise anlama sonucu (niyet/poliklinik/gün) loglanır; kullanıcı metni ASLA loglanmaz.
TESHIS_LOGU=0

# ================================================================ ai-simplify (sade_servisi, port 8001)
# Çalıştırma: .venv\Scripts\python.exe -m sade_servisi
# HASTAKABUL_API_URL ve SERVICE_KEY yukarıdakilerle ortaktır (backend'deki SERVICE_KEY ile aynı olmalı).
SADE_HOST=127.0.0.1
SADE_PORT=8001
# Callback (PUT /api/v1/summaries/{id}) ve KB okuma (GET /api/v1/kb) zaman aşımı
SADE_API_ZAMAN_ASIMI_SN=10
# LLM: her ayar önce SADE_LLM_*, yoksa LLM_* okunur. Ses servisiyle AYNI modeli kullanın:
# 6 GB GPU'da ikinci bir model yüklenirse Whisper/Ollama bellek yetmez.
SADE_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
SADE_LLM_SICAKLIK=0.1
# 0: LLM hiç kullanılmaz; tüm terimleri KB'de olan girdiler şablonla özetlenir, diğerleri LLM_UNAVAILABLE
SADE_LLM_ETKIN=1
# Tek üretim çağrısının zaman aşımı ve çıktı sınırı (çağrı başına; LLM_ZAMAN_ASIMI_SN'yi ezer)
SADE_URETIM_ZAMAN_ASIMI_SN=60
SADE_AZAMI_TOKEN=700
# Bilgi tabanı: auto = önce backend GET /api/v1/kb, yoksa gömülü 16 kayıt | gomulu = yalnız gömülü
SADE_KB_KAYNAGI=auto
SADE_KB_YENILEME_SN=600
# Kalıcı iş kuyruğu (SQLite). Yalnız işlemek için gereken veri; iş bitince silinir. Boşsa ./veri/sade_kuyruk.sqlite3
SADE_KUYRUK_DOSYASI=
SADE_AZAMI_KUYRUK=200
# Callback yeniden deneme: bekleme = min(azami, taban × 2^deneme) ±%10
SADE_GERI_CAGRI_AZAMI_DENEME=12
SADE_GERI_CAGRI_TABAN_BEKLEME_SN=2
SADE_GERI_CAGRI_AZAMI_BEKLEME_SN=300
# Girdi sınırları. Tanı ve satır uzunluğu aşılırsa 400 VALIDATION_FAILED (backend tanıyı 400 karakterle
# sınırlar). İlaç SAYISI yumuşak sınırdır: aşılırsa istek 202 ile kabul edilir ve özet SIMPLIFY_FAILED ile
# kapanır (backend 4xx alırsa girdiyle ilgisiz seed yedeğine düşebilir; sert sınır 200 satır).
SADE_AZAMI_TANI=1000
SADE_AZAMI_ILAC=30
SADE_AZAMI_ILAC_UZUNLUGU=500
