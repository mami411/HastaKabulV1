# Hasta Kabul Sistemi - API ortam degiskenleri
# Bu dosya ornektir; gercek degerler .env icinde tutulur ve depoya girmez.

# Veritabani (Docker Compose icinde host adi "db" olur)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hasta_kabul

# Kurulu bir PostgreSQL 5432'yi tutuyorsa konteyneri baska bir porta acin.
DB_HOST_PORT=5433
DATABASE_URL=Host=localhost;Port=5433;Database=hasta_kabul;Username=postgres;Password=postgres

# Arayuzlerin API adresi (kiosk 5173, hekim paneli 5174, portal 5175)
API_URL=http://localhost:3000

# Hekim secimi icin kisa omurlu JWT (en az 32 karakter)
JWT_SECRET=

# TC ozetine karisan pepper; veritabaninda bulunmaz, degistirilirse eski kayitlar eslesmez
TC_PEPPER=

# TC alan sifrelemesi icin 32 baytlik base64 anahtar
# Uretmek icin: openssl rand -base64 32
TC_ENCRYPTION_KEY=

# Servisler arasi kimlik: AI servisleri API'yi bu baslikla cagirir (X-Service-Key)
SERVICE_KEY=

# Sadelestirme servisi
SIMPLIFY_URL=http://127.0.0.1:8001

# Saglayici anahtarlari YALNIZCA ai-simplify ve ai-voice konteynerlerine verilir;
# API bu degiskenleri gormez. Burada yalnizca hatirlatma olarak listelenir.
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Mock sunucuya mi gercek API'ye mi baglanilacagi (frontend tarafinda kullanilir)
USE_MOCKS=false
