# Hasta Kabul — ön yüz ortam değişkenleri
# Kopyalayın: cp .env.example .env.local

# Hasta kabul REST API'si (backend)
VITE_API_URL=http://localhost:3000

# Ses orkestratörü (ai-voice): konuşma akışı, saat önerisi ve randevu
VITE_ORCHESTRATOR_URL=http://localhost:8002

# Konuşma tanıma (/stt) ve seslendirme (/tts) de ai-voice üzerindedir
VITE_VOICE_URL=http://localhost:8002

# 1 = tüm istekler göreli adrese gider (Vite vekili iletir); yukarıdaki üç adres yok sayılır.
# Telefon demo modunda (npm run dev:mobil) .env.mobil bunu kendisi açar.
VITE_SAME_ORIGIN=0

# Hareketsizlik kilidi (sn): dolunca sohbet silinir, TC ile yeniden giriş istenir.
# Kilitten önce son 30 sn (süre kısaysa üçte biri) uyarı gösterilir.
VITE_IDLE_TIMEOUT_SEC=300

# Orkestratör isteği zaman aşımı (ms); aşılırsa onay sonucu "doğrulanamadı" sayılır
VITE_ORCHESTRATOR_TIMEOUT_MS=30000

# Konuşma döngüsü: asistan konuştuktan sonra mikrofon kendiliğinden açılır (0 = yalnız elle)
VITE_VOICE_LOOP=1
# Konuşma algılama (VAD): konuşma sonrası sessizlik (ms), hiç konuşulmazsa vazgeçme (ms),
# azami kayıt (ms), konuşma sayılacak en kısa ses (ms) ve RMS enerji alt eşiği (0–1)
VITE_VAD_SILENCE_MS=1300
VITE_VAD_NO_SPEECH_MS=7000
VITE_VAD_MAX_MS=15000
VITE_VAD_MIN_SPEECH_MS=250
VITE_VAD_THRESHOLD=0.02

# --- Yalnız telefon demo modu (vite.config.ts okur; tarayıcıya gitmez) ---
# Vekilin hedefleri ve HTTPS portu
# HK_API_TARGET=http://127.0.0.1:3000
# HK_VOICE_TARGET=http://127.0.0.1:8002
# HK_MOBIL_PORT=5174
